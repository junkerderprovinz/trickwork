node_modules/
dist/
*.log
.DS_Store
# Wails generates the platform bundles in desktop/build/, but appicon.png is
# the source every platform icon is made from; untracked, CI falls back to
# Wails' default icon.
desktop/build/*
!desktop/build/appicon.png
# Wails writes the rest of the Windows installer on every build; the script is ours.
!desktop/build/windows/
desktop/build/windows/*
!desktop/build/windows/installer/
desktop/build/windows/installer/*
!desktop/build/windows/installer/project.nsi
webembed/dist/
test-results/
playwright-report/
ui/wailsjs/
ui/package.json.md5
